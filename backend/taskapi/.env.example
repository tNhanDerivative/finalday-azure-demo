DJANGO_ENV=production
SECRET_KEY=replace-with-a-strong-secret
DEBUG=False
ALLOWED_HOSTS=<app-name>.azurewebsites.net,localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://<frontend-domain>
CSRF_TRUSTED_ORIGINS=https://<frontend-domain>,https://<app-name>.azurewebsites.net

DATABASE_URL=postgresql://<db-user>:<db-password>@<server-name>.postgres.database.azure.com:5432/<database-name>?sslmode=require
